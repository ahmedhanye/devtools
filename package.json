{
  "name": "devtools",
  "version": "0.1.0",
  "description": "Developer tooling monorepo providing development utilities and workflows across CLI, daemon, API, and frontend interfaces.",
  "license": "MIT",
  "author": "Ahmed Hanye",
  "repository": "https://github.com/AhmedHanye/devtools.git",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "site"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "oxlint --deny-warnings . && prettier --check .",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter '*' test && bun test scripts/",
    "test:unit": "bun --filter '*' test:unit && bun test scripts/**/*.unit.test.ts",
    "test:integration": "bun --filter '*' test:integration",
    "test:e2e": "bun --filter '*' test:e2e",
    "test:coverage": "bun scripts/collect-coverage/collect-coverage.ts",
    "build": "bun --filter '*' build",
    "build:bin": "bun build apps/cli/bin/devtools.js --compile --outfile dist/devtools",
    "build:smoke": "bun run build:bin && ./dist/devtools --help && ./dist/devtools --version",
    "build:darwin-arm64": "bun build apps/cli/bin/devtools.js --compile --target=bun-darwin-arm64 --outfile dist/devtools-darwin-arm64",
    "audit": "bun audit --audit-level=high --ignore GHSA-vfj7-8cjw-p6xm --ignore GHSA-mrhx-c7xc-m3w5",
    "pin:actions": ".agents/skills/github-actions/scripts/pin-action.sh",
    "lint:workflows": ".agents/skills/github-actions/scripts/lint.sh",
    "lint:agents": "bun scripts/verify-agents-governance/verify-agents-governance.ts",
    "lint:fsd": "bun --filter @devtools/frontend lint:fsd",
    "lint:design": "bun --filter @devtools/frontend lint:design",
    "fallow:dead-code": "fallow dead-code --type-aware",
    "fallow:dupes": "fallow dupes --mode semantic",
    "fallow:arch": "fallow architecture",
    "fallow:health": "fallow health --min-score 70",
    "fallow:security": "fallow security",
    "react-doctor": "CI=true react-doctor --project apps/frontend,site --no-telemetry --no-supply-chain && CI=true react-doctor design --project apps/frontend,site --no-telemetry --no-supply-chain",
    "verify:diff-coverage": "bun scripts/verify-diff-coverage/verify-diff-coverage.ts",
    "verify:fast": "bun run check && bun run typecheck && bun run fallow:dead-code && bun run fallow:arch && bun run fallow:health && bun run lint:agents && bun --filter @devtools/frontend test",
    "verify": "bun run verify:fast && bun run lint:design && bun run lint:fsd && bun run fallow:dupes && bun run react-doctor && bun run build:bin && bun run test:coverage && bun run verify:diff-coverage && bun run audit && bun run build:smoke && bun run lint:workflows"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "latest",
    "fallow": "^3.38.1",
    "lefthook": "^2.2.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "vite": "^8.3.5"
  }
}
