{
  "name": "devtools",
  "version": "0.1.0",
  "description": "Developer tooling monorepo providing development utilities and workflows across CLI, daemon, API, and frontend interfaces.",
  "license": "MIT",
  "author": "Ahmed Hanye",
  "repository": "https://github.com/AhmedHanye/devtools.git",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "site"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives --format=agent .",
    "lint:fix": "oxlint --deny-warnings --report-unused-disable-directives --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run lint && bun run format:check",
    "check:fix": "bun run lint:fix && bun run format",
    "typecheck": "turbo run typecheck typecheck:scripts",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:coverage:scripts": "bun test --only-failures scripts/ --coverage --coverage-reporter=lcov --coverage-dir=coverage/scripts",
    "test:coverage": "turbo run test:coverage test:coverage:scripts && bun scripts/merge-coverage/merge-coverage.ts",
    "build": "turbo run build",
    "build:bin": "bun build apps/cli/bin/devtools.js --compile --minify --bytecode --format=esm --outfile dist/devtools",
    "smoke:bin": "./dist/devtools --help && ./dist/devtools --version",
    "build:smoke": "bun run build:bin && bun run smoke:bin",
    "build:darwin-arm64": "bun build apps/cli/bin/devtools.js --compile --minify --bytecode --format=esm --target=bun-darwin-arm64 --outfile dist/devtools-darwin-arm64",
    "audit": "bun audit --audit-level=high",
    "pin:actions": "gh actions-lock --ignore-local-actions",
    "lint:workflows": ".agents/skills/github-actions/scripts/lint.sh",
    "lint:agents": "bun scripts/verify-agents-governance/verify-agents-governance.ts",
    "lint:fsd": "turbo run lint:fsd",
    "fallow:check": "fallow --type-aware --health-baseline fallow-baselines/health-baseline.json --dupes-baseline fallow-baselines/dupes-baseline.json --baseline-mode identity --fail-on-issues",
    "fallow:dead-code": "fallow dead-code --type-aware",
    "fallow:dupes": "fallow dupes --mode semantic --baseline fallow-baselines/dupes-baseline.json --fail-on-issues",
    "fallow:arch": "fallow architecture",
    "fallow:health": "fallow health --baseline fallow-baselines/health-baseline.json --baseline-mode identity --fail-on-issues",
    "fallow:security": "fallow security",
    "react-doctor:design": "CI=true react-doctor design --project apps/frontend,site --no-telemetry --no-supply-chain --blocking warning",
    "verify:actions-lock": "gh actions-lock --verify-local --ignore-local-actions",
    "verify:db-migrations": "bun scripts/verify-db-migrations/verify-db-migrations.ts",
    "verify:diff-coverage": "bun scripts/verify-diff-coverage/verify-diff-coverage.ts",
    "verify:push-secrets": "bun scripts/verify-staged-secrets/verify-staged-secrets.ts --range",
    "verify": "turbo run lint format:check typecheck typecheck:scripts lint:fsd react-doctor:design fallow:check lint:agents verify:db-migrations verify:actions-lock build build-storybook build:bin smoke:bin test:coverage test:coverage:scripts --concurrency=6 && bunx fallow security --gate new --changed-since \"${BASE_REF:-origin/main}\" --workspace 'apps/*,packages/*,site' && bun scripts/merge-coverage/merge-coverage.ts && bun run verify:diff-coverage"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "latest",
    "fallow": "3.48.0",
    "fallow-type-aware": "3.48.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.93.0",
    "oxlint-plugin-react-doctor": "^0.9.23",
    "oxlint-tsgolint": "^7.0.2007",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "vite": "^8.3.5",
    "zod": "^4.6.7",
    "eslint-plugin-react-hooks/zod-validation-error": "^4.0.2"
  }
}
