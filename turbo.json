{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json"],
  "globalEnv": [
    "CI",
    "BASE_REF",
    "NO_COLOR",
    "DO_NOT_TRACK",
    "NEXT_TELEMETRY_DISABLED",
    "STORYBOOK_DISABLE_TELEMETRY",
    "FALLOW_TELEMETRY_DISABLED",
    "REACT_DOCTOR_NO_TELEMETRY"
  ],
  "tasks": {
    "transit": {
      "description": "Internal cache-invalidation node for buildless JIT workspace dependencies",
      "dependsOn": ["^transit"]
    },
    "dev": {
      "description": "Run workspace development server",
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "description": "Typecheck workspace TypeScript sources via tsgo",
      "dependsOn": ["transit"],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "//#typecheck:scripts": {
      "description": "Typecheck repository tooling scripts under scripts/",
      "inputs": [
        "scripts/**/*.ts",
        "scripts/tsconfig.json",
        "packages/db/src/schema/**",
        "packages/db/src/migrator.ts",
        "tsconfig.base.json"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "build": {
      "description": "Build deployable applications and documentation site",
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.stories.{tsx,jsx,mdx}"],
      "outputLogs": "errors-only",
      "outputs": [
        "dist/**",
        "out/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        ".source/**"
      ]
    },
    "build-storybook": {
      "description": "Build static Storybook component catalog",
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!storybook-static/**",
        "!coverage/**",
        "!.next/**",
        "!out/**"
      ],
      "outputLogs": "errors-only",
      "outputs": ["storybook-static/**"]
    },
    "test": {
      "description": "Run workspace test suites",
      "dependsOn": ["^build", "transit"],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "test:unit": {
      "description": "Run workspace unit tests",
      "dependsOn": ["transit"],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "test:integration": {
      "description": "Run workspace integration tests",
      "dependsOn": ["transit"],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "test:e2e": {
      "description": "Run workspace end-to-end tests",
      "dependsOn": ["transit"],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "test:coverage": {
      "description": "Run workspace tests with LCOV coverage output",
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "!coverage/**"],
      "outputLogs": "errors-only",
      "outputs": ["coverage/lcov.info"]
    },
    "//#test:scripts": {
      "description": "Run tests for repository scripts",
      "inputs": [
        "scripts/**/*.ts",
        "scripts/tsconfig.json",
        "packages/db/src/schema/**",
        "packages/db/src/migrator.ts",
        "packages/db/drizzle/**",
        ".agents/**",
        "bunfig.toml",
        "bun.lock"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "//#test:unit:scripts": {
      "description": "Run unit tests for repository scripts",
      "inputs": [
        "scripts/**/*.ts",
        "scripts/tsconfig.json",
        "packages/db/src/schema/**",
        "packages/db/src/migrator.ts",
        "packages/db/drizzle/**",
        ".agents/**",
        "bunfig.toml",
        "bun.lock"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "//#test:coverage:scripts": {
      "description": "Run repository script tests with LCOV coverage output",
      "inputs": [
        "scripts/**/*.ts",
        "scripts/tsconfig.json",
        "packages/db/src/schema/**",
        "packages/db/src/migrator.ts",
        "packages/db/drizzle/**",
        ".agents/**",
        "bunfig.toml",
        "bun.lock"
      ],
      "outputLogs": "errors-only",
      "outputs": ["coverage/scripts/lcov.info"]
    },
    "//#boundaries": {
      "description": "Verify Turborepo workspace import boundaries and undeclared dependencies",
      "inputs": [
        "apps/**/*.{ts,tsx,js,jsx,mjs}",
        "packages/**/*.{ts,tsx,js,jsx,mjs}",
        "site/**/*.{ts,tsx,js,jsx,mjs}",
        "apps/*/package.json",
        "packages/*/package.json",
        "site/package.json",
        "package.json",
        "turbo.json",
        "apps/*/turbo.json",
        "!**/coverage/**",
        "!**/.next/**",
        "!**/out/**",
        "!**/.source/**",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.turbo/**"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "//#lint": {
      "description": "Lint repository source files with oxlint",
      "inputs": [
        "apps/**/*.{ts,tsx,js,jsx,mjs}",
        "packages/**/*.{ts,tsx,js,jsx,mjs}",
        "site/**/*.{ts,tsx,js,jsx,mjs}",
        "scripts/**/*.{ts,tsx,js,jsx,mjs}",
        ".oxlintrc.json",
        "apps/frontend/.oxlintrc.json",
        "site/.oxlintrc.json",
        "tsconfig.base.json",
        "package.json",
        "!**/coverage/**",
        "!**/.next/**",
        "!**/out/**",
        "!**/.source/**",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.turbo/**"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "//#format:check": {
      "description": "Check formatting across repository files with oxfmt",
      "inputs": [
        "apps/**",
        "packages/**",
        "site/**",
        "scripts/**",
        "docs/**",
        ".github/**",
        "*.md",
        "*.json",
        "*.yml",
        "*.yaml",
        ".oxfmtrc.json",
        "!**/coverage/**",
        "!**/.next/**",
        "!**/out/**",
        "!**/.source/**",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.turbo/**"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "//#fallow:check": {
      "description": "Check dead code, duplication, complexity, and architectural boundaries with fallow",
      "inputs": [
        "apps/**/*.{ts,tsx}",
        "packages/**/*.{ts,tsx}",
        "site/**/*.{ts,tsx}",
        "scripts/**/*.ts",
        ".fallowrc.json",
        "fallow-baselines/**",
        "package.json",
        "bun.lock",
        "tsconfig.base.json",
        "!**/coverage/**",
        "!**/.next/**",
        "!**/out/**",
        "!**/.source/**",
        "!**/dist/**",
        "!**/.turbo/**"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "//#lint:agents": {
      "description": "Verify agent governance rules and skill manifests",
      "inputs": [".agents/**", "scripts/verify-agents-governance/**"],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "//#verify:db-migrations": {
      "description": "Verify Drizzle schema matches generated SQLite migrations",
      "inputs": [
        "packages/db/src/schema/**",
        "packages/db/drizzle/**",
        "packages/db/drizzle.config.ts",
        "packages/db/src/migrator.ts",
        "scripts/verify-db-migrations/**"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "//#verify:actions-lock": {
      "description": "Verify GitHub Actions workflow pins via actions-lock",
      "inputs": [".github/workflows/**"],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "lint:fsd": {
      "description": "Verify Feature-Sliced Design v2.1 rules with Steiger",
      "inputs": ["src/**", "steiger.config.js"],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "//#react-doctor:design": {
      "description": "Run react-doctor design and accessibility checks on frontend and site",
      "inputs": [
        "apps/frontend/**/*.{ts,tsx,css}",
        "site/**/*.{ts,tsx,css}",
        "doctor.config.json",
        "!**/coverage/**",
        "!**/.next/**",
        "!**/out/**",
        "!**/.source/**",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.turbo/**"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    }
  }
}
