    "test:coverage": "fumadocs-mdx && bun test --coverage"
  },
  "dependencies": {
    "fumadocs-core": "^16.17.8",
    "fumadocs-ui": "^16.17.8",
    "lucide-react": "^1.61.0",
    "mermaid": "^12.2.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fumadocs-mdx": "^15.4.10",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3"
  }
}
