{
  "name": "@devtools/site",
  "description": "Developer tooling documentation platform and guides",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
