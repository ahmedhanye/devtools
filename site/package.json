{
  "name": "@devtools/site",
  "description": "Developer tooling documentation platform and guides",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "pretest": "fumadocs-mdx",
    "test": "fumadocs-mdx && bun test",
    "test:unit": "bun test tests/*.unit.test.ts",
    "test:integration": "fumadocs-mdx && bun test tests/*.integration.test.ts tests/*.integration.test.tsx",
    "test:e2e": "fumadocs-mdx && bun test tests/*.e2e.test.tsx",
    "test:coverage": "fumadocs-mdx && bun test --coverage"
  },
  "dependencies": {
    "fumadocs-core": "^16.18.3",
    "fumadocs-ui": "^16.18.3",
    "lucide-react": "^1.70.0",
    "mermaid": "^12.3.0",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fumadocs-mdx": "^15.5.2",
    "happy-dom": "^21.0.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3"
  }
}
