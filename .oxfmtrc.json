{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortPackageJson": false,
  "overrides": [
    {
      "files": ["apps/frontend/**/*.{ts,tsx,css}"],
      "options": {
        "sortTailwindcss": {
          "stylesheet": "apps/frontend/src/app/globals.css",
          "functions": ["cn", "clsx", "cva"]
        }
      }
    }
  ],
  "ignorePatterns": [
    "dist",
    "out",
    ".next",
    ".turbo",
    "node_modules",
    "bun.lock",
    "skills-lock.json",
    ".agents/skills/codebase-design",
    ".agents/skills/fallow",
    ".agents/skills/feature-sliced-design",
    ".agents/skills/grill-with-docs",
    ".agents/skills/react-doctor",
    ".agents/skills/tdd",
    ".agents/skills/unslop",
    "tmp",
    "storybook-static",
    ".source",
    "coverage"
  ]
}
