{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "apps/frontend/steiger.config.js",
    "packages/browser/src/index.ts",
    "packages/core/src/index.ts",
    "packages/db/src/index.ts",
    "packages/lighthouse/src/index.ts",
    "packages/lighthouse/src/worker.ts"
  ],
  "ignoreDependencies": ["prettier-plugin-tailwindcss"],
  "ignoreUnresolvedImports": [
    "./.next/**",
    "**/.next/**",
    "**/.source/**",
    "@/.source/**"
  ],
  "rules": {
    "policy-violation": "off"
  },
  "duplicates": {
    "mode": "semantic",
    "ignore": [
      "**/*.css",
      "**/*.stories.tsx",
      "apps/frontend/src/shared/ui/shadcn/**"
    ]
  },
  "overrides": [
    {
      "files": ["packages/**/errors.ts", "packages/**/src/**/errors.ts"],
      "rules": {
        "unused-class-member": "off"
      }
    },
    {
      "files": ["apps/frontend/src/shared/ui/shadcn/**"],
      "rules": {
        "unused-export": "off"
      }
    }
  ],
  "boundaries": {
    "zones": [
      {
        "name": "core",
        "patterns": ["packages/core/src/**"]
      },
      {
        "name": "db",
        "patterns": ["packages/db/src/**"]
      },
      {
        "name": "browser",
        "patterns": ["packages/browser/src/**"]
      },
      {
        "name": "lighthouse",
        "patterns": ["packages/lighthouse/src/**"]
      },
      {
        "name": "api",
        "patterns": ["apps/api/src/**"]
      },
      {
        "name": "cli",
        "patterns": ["apps/cli/src/**"]
      },
      {
        "name": "frontend-app",
        "patterns": ["apps/frontend/src/app/**"]
      },
      {
        "name": "frontend-pages",
        "patterns": ["apps/frontend/src/pages/**"]
      },
      {
        "name": "frontend-shared",
        "patterns": ["apps/frontend/src/shared/**"]
      }
    ],
    "rules": [
      {
        "from": "core",
        "allow": []
      },
      {
        "from": "db",
        "allow": ["core"]
      },
      {
        "from": "browser",
        "allow": ["core"]
      },
      {
        "from": "lighthouse",
        "allow": ["core", "db", "browser"]
      },
      {
        "from": "api",
        "allow": ["core", "db", "browser", "lighthouse"]
      },
      {
        "from": "cli",
        "allow": ["core", "db", "browser", "lighthouse", "api"]
      },
      {
        "from": "frontend-app",
        "allow": ["frontend-pages", "frontend-shared", "core"]
      },
      {
        "from": "frontend-pages",
        "allow": ["frontend-shared", "core"]
      },
      {
        "from": "frontend-shared",
        "allow": ["core"]
      }
    ]
  },
  "regression": {
    "baseline": {
      "analysisIdentity": {
        "mode": "syntactic",
        "semantic_schema_version": 1,
        "capabilities": [],
        "project_config_hash": "",
        "backend_family": "",
        "completeness": "complete"
      },
      "totalIssues": 0,
      "unusedFiles": 0,
      "unusedExports": 0,
      "unusedTypes": 0,
      "unusedDependencies": 0,
      "unusedDevDependencies": 0,
      "unusedOptionalDependencies": 0,
      "unusedEnumMembers": 0,
      "unusedClassMembers": 0,
      "unresolvedImports": 0,
      "unlistedDependencies": 0,
      "duplicateExports": 0,
      "circularDependencies": 0,
      "reExportCycles": 0,
      "packageCycles": 0,
      "typeOnlyDependencies": 0,
      "testOnlyDependencies": 0,
      "devDependenciesInProduction": 0,
      "boundaryViolations": 0,
      "boundaryCoverageViolations": 0,
      "boundaryCallViolations": 0,
      "policyViolations": 0
    }
  }
}
