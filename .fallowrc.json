{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["apps/frontend/steiger.config.js"],
  "ignoreDependencyOverrides": [
    {
      "package": "eslint-plugin-react-hooks/zod-validation-error",
      "source": "package.json"
    }
  ],
  "ignoreUnresolvedImports": [
    "./.next/**",
    "**/.next/**",
    "**/.source/**",
    "@/.source/**"
  ],
  "usedClassMembers": [
    {
      "extends": "Error",
      "members": ["exitCode", "code"]
    }
  ],
  "rules": {
    "policy-violation": "off",
    "private-type-leaks": "error",
    "prop-drilling": "warn",
    "thin-wrapper": "warn",
    "duplicate-prop-shape": "warn"
  },
  "duplicates": {
    "mode": "semantic",
    "threshold": 7.5,
    "ignore": [
      "**/*.css",
      "**/*.stories.tsx",
      "apps/frontend/src/shared/ui/shadcn/**",
      "packages/lighthouse/src/infra/runtime/bundled-modules.ts"
    ]
  },
  "health": {
    "ignore": [
      "packages/lighthouse/src/infra/runtime/bundled-modules.ts",
      "scripts/**",
      "**/*.test.*",
      "**/*.spec.*",
      "**/tests/**",
      "**/*.stories.tsx",
      "apps/frontend/.storybook/**"
    ]
  },
  "overrides": [
    {
      "files": ["apps/frontend/src/shared/ui/shadcn/**"],
      "rules": {
        "unused-file": "off",
        "unused-export": "off",
        "prop-drilling": "off",
        "thin-wrapper": "off",
        "duplicate-prop-shape": "off"
      }
    }
  ],
  "boundaries": {
    "zones": [
      {
        "name": "core-node",
        "patterns": ["packages/core/src/node/**"]
      },
      {
        "name": "core",
        "patterns": ["packages/core/src/**", "!packages/core/src/node/**"]
      },
      {
        "name": "db",
        "patterns": ["packages/db/src/**"]
      },
      {
        "name": "browser",
        "patterns": ["packages/browser/src/**"]
      },
      {
        "name": "lighthouse-schemas",
        "patterns": ["packages/lighthouse/src/contracts/schemas.ts"]
      },
      {
        "name": "lighthouse-contracts",
        "patterns": [
          "packages/lighthouse/src/contracts/**",
          "!packages/lighthouse/src/contracts/schemas.ts"
        ],
        "publicFiles": ["**/index.ts"]
      },
      {
        "name": "lighthouse-domain",
        "patterns": ["packages/lighthouse/src/domain/**"],
        "publicFiles": ["**/index.ts"]
      },
      {
        "name": "lighthouse-application",
        "patterns": ["packages/lighthouse/src/application/**"],
        "publicFiles": ["**/index.ts"]
      },
      {
        "name": "lighthouse-config",
        "patterns": ["packages/lighthouse/src/config/**"],
        "publicFiles": ["**/index.ts"]
      },
      {
        "name": "lighthouse-internals",
        "patterns": ["packages/lighthouse/src/infra/**"]
      },
      {
        "name": "lighthouse-wiring",
        "patterns": [
          "packages/lighthouse/src/wiring.ts",
          "packages/lighthouse/src/serializers.ts"
        ]
      },
      {
        "name": "api-shared",
        "patterns": ["apps/api/src/shared/**"],
        "publicFiles": ["**/index.ts"]
      },
      {
        "name": "api-modules",
        "autoDiscover": ["apps/api/src/modules"],
        "publicFiles": ["**/index.ts"]
      },
      {
        "name": "api-app",
        "patterns": ["apps/api/src/app/**", "apps/api/src/index.ts"],
        "publicFiles": ["apps/api/src/index.ts", "apps/api/src/app/index.ts"]
      },
      {
        "name": "cli-shared",
        "patterns": ["apps/cli/src/shared/**"],
        "publicFiles": ["**/index.ts"]
      },
      {
        "name": "cli-commands",
        "autoDiscover": ["apps/cli/src/commands"],
        "publicFiles": ["**/index.ts"]
      },
      {
        "name": "cli-daemon",
        "patterns": ["apps/cli/src/daemon/**"],
        "publicFiles": ["**/index.ts"]
      },
      {
        "name": "cli-app",
        "patterns": ["apps/cli/src/app/**", "apps/cli/src/index.ts"],
        "publicFiles": ["apps/cli/src/index.ts", "apps/cli/src/app/index.ts"]
      },
      {
        "name": "frontend-app",
        "patterns": ["apps/frontend/src/app/**"]
      },
      {
        "name": "frontend-pages",
        "patterns": ["apps/frontend/src/pages/**"]
      },
      {
        "name": "frontend-features",
        "patterns": ["apps/frontend/src/features/**"]
      },
      {
        "name": "frontend-entities",
        "patterns": ["apps/frontend/src/entities/**"]
      },
      {
        "name": "frontend-shared",
        "patterns": ["apps/frontend/src/shared/**"]
      }
    ],
    "rules": [
      {
        "from": "core",
        "allow": []
      },
      {
        "from": "core-node",
        "allow": ["core"]
      },
      {
        "from": "db",
        "allow": ["core", "core-node"]
      },
      {
        "from": "browser",
        "allow": ["core", "core-node"]
      },
      {
        "from": "lighthouse-schemas",
        "allow": []
      },
      {
        "from": "lighthouse-contracts",
        "allow": ["lighthouse-schemas"],
        "allowTypeOnly": ["core", "core-node", "browser"]
      },
      {
        "from": "lighthouse-domain",
        "allow": ["lighthouse-schemas", "lighthouse-contracts"]
      },
      {
        "from": "lighthouse-application",
        "allow": [
          "lighthouse-schemas",
          "lighthouse-contracts",
          "lighthouse-domain"
        ],
        "allowTypeOnly": ["core", "core-node", "browser"]
      },
      {
        "from": "lighthouse-config",
        "allow": ["core", "core-node"]
      },
      {
        "from": "lighthouse-internals",
        "allow": [
          "core",
          "core-node",
          "db",
          "browser",
          "lighthouse-schemas",
          "lighthouse-contracts",
          "lighthouse-domain",
          "lighthouse-config"
        ],
        "allowTypeOnly": ["lighthouse-application"]
      },
      {
        "from": "lighthouse-wiring",
        "allow": [
          "core",
          "core-node",
          "browser",
          "lighthouse-schemas",
          "lighthouse-contracts",
          "lighthouse-domain",
          "lighthouse-application",
          "lighthouse-config",
          "lighthouse-internals"
        ],
        "allowTypeOnly": ["db"]
      },
      {
        "from": "api-shared",
        "allow": ["core"]
      },
      {
        "from": "api-modules",
        "allow": ["api-shared", "core"]
      },
      {
        "from": "api-modules/lighthouse",
        "allow": [
          "api-shared",
          "core",
          "core-node",
          "lighthouse-schemas",
          "lighthouse-contracts",
          "lighthouse-domain",
          "lighthouse-application",
          "lighthouse-config",
          "lighthouse-wiring"
        ]
      },
      {
        "from": "api-app",
        "allow": [
          "api-shared",
          "api-modules",
          "api-modules/health",
          "api-modules/lighthouse",
          "core",
          "core-node",
          "db",
          "lighthouse-wiring"
        ],
        "allowTypeOnly": ["lighthouse-application", "lighthouse-contracts"]
      },
      {
        "from": "cli-shared",
        "allow": ["core", "core-node"]
      },
      {
        "from": "cli-commands",
        "allow": ["cli-shared", "core", "core-node"]
      },
      {
        "from": "cli-daemon",
        "allow": ["cli-shared", "core", "core-node", "db", "api-app"],
        "allowTypeOnly": ["lighthouse-application", "lighthouse-wiring"]
      },
      {
        "from": "cli-commands/web",
        "allow": ["cli-shared", "cli-daemon", "core", "core-node"]
      },
      {
        "from": "cli-commands/browser",
        "allow": ["cli-shared", "core", "core-node", "browser"]
      },
      {
        "from": "cli-commands/lighthouse",
        "allow": [
          "cli-shared",
          "core",
          "core-node",
          "lighthouse-schemas",
          "lighthouse-contracts",
          "lighthouse-domain",
          "lighthouse-application",
          "lighthouse-config",
          "lighthouse-wiring"
        ]
      },
      {
        "from": "cli-app",
        "allow": [
          "cli-shared",
          "cli-commands",
          "cli-commands/web",
          "cli-commands/browser",
          "cli-commands/lighthouse",
          "cli-daemon",
          "core",
          "core-node",
          "db",
          "lighthouse-wiring"
        ],
        "allowTypeOnly": ["lighthouse-application"]
      },
      {
        "from": "frontend-app",
        "allow": [
          "frontend-pages",
          "frontend-features",
          "frontend-entities",
          "frontend-shared",
          "core",
          "lighthouse-schemas"
        ]
      },
      {
        "from": "frontend-pages",
        "allow": [
          "frontend-features",
          "frontend-entities",
          "frontend-shared",
          "core",
          "lighthouse-schemas"
        ]
      },
      {
        "from": "frontend-features",
        "allow": [
          "frontend-entities",
          "frontend-shared",
          "core",
          "lighthouse-schemas"
        ]
      },
      {
        "from": "frontend-entities",
        "allow": ["frontend-shared", "core", "lighthouse-schemas"]
      },
      {
        "from": "frontend-shared",
        "allow": ["core", "lighthouse-schemas"]
      }
    ],
    "coverage": {
      "requireAllFiles": true,
      "allowUnmatched": [
        "site/**",
        "scripts/**",
        "commitlint.config.mjs",
        "apps/cli/bin/**",
        "apps/frontend/.storybook/**",
        "apps/frontend/*.config.{ts,js,mjs}",
        "apps/frontend/vitest.setup.ts",
        "apps/frontend/next-env.d.ts",
        "packages/db/drizzle.config.ts",
        "packages/*/src/**/declarations.d.ts",
        "apps/*/src/**/declarations.d.ts",
        "**/*.test.{ts,tsx,js}",
        "**/*.spec.{ts,tsx,js}",
        "**/*.stories.{ts,tsx}",
        "**/tests/**"
      ]
    },
    "calls": {
      "forbidden": [
        {
          "from": "core",
          "callee": ["fs.*", "child_process.*", "process.exit"]
        },
        {
          "from": "lighthouse-schemas",
          "callee": ["fs.*", "child_process.*", "process.exit", "Bun.*"]
        },
        {
          "from": "lighthouse-contracts",
          "callee": ["fs.*", "child_process.*", "process.exit", "Bun.*"]
        },
        {
          "from": "lighthouse-domain",
          "callee": ["fs.*", "child_process.*", "process.exit", "Bun.*"]
        },
        {
          "from": "lighthouse-application",
          "callee": ["fs.*", "child_process.*", "process.exit", "Bun.*"]
        },
        {
          "from": "api-shared",
          "callee": ["fs.*", "child_process.*", "process.exit"]
        }
      ]
    }
  },
  "regression": {
    "baseline": {
      "analysisIdentity": {
        "mode": "syntactic",
        "semantic_schema_version": 1,
        "capabilities": [],
        "project_config_hash": "",
        "backend_family": "",
        "completeness": "complete"
      },
      "totalIssues": 0,
      "unusedFiles": 0,
      "unusedExports": 0,
      "unusedTypes": 0,
      "unusedDependencies": 0,
      "unusedDevDependencies": 0,
      "unusedOptionalDependencies": 0,
      "unusedEnumMembers": 0,
      "unusedClassMembers": 0,
      "unresolvedImports": 0,
      "unlistedDependencies": 0,
      "duplicateExports": 0,
      "circularDependencies": 0,
      "reExportCycles": 0,
      "packageCycles": 0,
      "typeOnlyDependencies": 0,
      "testOnlyDependencies": 0,
      "devDependenciesInProduction": 0,
      "boundaryViolations": 0,
      "boundaryCoverageViolations": 0,
      "boundaryCallViolations": 0,
      "policyViolations": 0
    }
  }
}
