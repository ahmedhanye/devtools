{
  "name": "@devtools/lighthouse",
  "description": "Isolated Lighthouse v13 audit engine, metric extraction, and persistence services for DevTools",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./schemas": "./src/contracts/schemas.ts",
    "./contracts": "./src/contracts/index.ts",
    "./domain": "./src/domain/index.ts",
    "./application": "./src/application/index.ts",
    "./config": "./src/config/index.ts",
    "./serializers": "./src/serializers.ts",
    "./wiring": "./src/wiring.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test tests/*.unit.test.ts",
    "test:integration": "bun test tests/*.integration.test.ts",
    "test:e2e": "bun test tests/*.e2e.test.ts",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir=coverage"
  },
  "dependencies": {
    "@devtools/browser": "workspace:*",
    "@devtools/core": "workspace:*",
    "@devtools/db": "workspace:*",
    "lighthouse": "^13.5.0",
    "lighthouse-logger": "^2.0.2",
    "zod": "^4.6.7"
  }
}
