{
  "name": "@devtools/browser",
  "description": "Chromium browser provisioning, detection, and lifecycle management for DevTools",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test tests/*.unit.test.ts",
    "test:integration": "bun test tests/*.integration.test.ts",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir=coverage"
  },
  "dependencies": {
    "@devtools/core": "workspace:*",
    "@puppeteer/browsers": "^3.2.7",
    "chrome-launcher": "^1.2.3"
  }
}
