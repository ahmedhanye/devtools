{
  "name": "@devtools/core",
  "version": "0.1.0",
  "description": "Shared domain models, configuration schemas, and utilities",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test tests/*.unit.test.ts",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir=coverage"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
