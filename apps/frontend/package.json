{
  "name": "@devtools/frontend",
  "description": "Developer tooling web dashboard and UI",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:unit": "vitest run unit",
    "test:e2e": "vitest run stories",
    "test:coverage": "vitest run --coverage",
    "typecheck": "next typegen && tsc --noEmit",
    "lint:fsd": "steiger ./src",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint:design": "oxlint --deny-warnings -c .oxlintrc.json",
    "doctor": "CI=true react-doctor --no-telemetry --no-supply-chain"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@shadcn/lint": "^0.2.5",
    "@storybook/nextjs-vite": "^10.6.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "happy-dom": "^21.0.1",
    "postcss": "^8.5.33",
    "react-doctor": "^0.9.23",
    "steiger": "^0.10.0",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.3",
    "vite-plugin-storybook-nextjs": "^10.6.2",
    "vitest": "^5.1.0"
  }
}
